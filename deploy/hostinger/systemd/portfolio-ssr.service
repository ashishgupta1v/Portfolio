[Unit]
Description=Portfolio Inertia SSR server
After=network.target

[Service]
User=www-data
Group=www-data
Restart=always
RestartSec=5
WorkingDirectory=/var/www/portfolio/current
Environment=PORT=13715
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /var/www/portfolio/current/bootstrap/ssr/ssr.js
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
